{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "prebuild": "npx prisma generate",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "rm -rf .next && playwright test",
    "test:e2e:functional": "rm -rf .next && playwright test --grep-invert @a11y",
    "test:e2e:newsletter": "rm -rf .next && playwright test tests/e2e/holding-page.spec.ts tests/e2e/public/newsletter/journeys.spec.ts",
    "test:e2e:regression": "pnpm run test:e2e:functional",
    "test:a11y": "rm -rf .next && playwright test tests/e2e/public/accessibility.spec.ts",
    "test:lighthouse": "node scripts/lighthouse-public-scan.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "lint": "eslint --no-warn-ignored contentful prisma scripts src eslint.config.mjs middleware.ts next-env.d.ts next.config.mjs postcss.config.mjs prisma.config.ts",
    "lint:fix": "eslint --no-warn-ignored contentful prisma scripts src eslint.config.mjs middleware.ts next-env.d.ts next.config.mjs postcss.config.mjs prisma.config.ts --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "code:fix": "pnpm run format && pnpm run lint:fix && pnpm run format",
    "contentful:migrate": "node --experimental-strip-types --experimental-specifier-resolution=node contentful/scripts/apply-migrations.ts",
    "contentful:seed:drafts": "node --experimental-strip-types --experimental-specifier-resolution=node contentful/scripts/seed-drafts.ts",
    "contentful:dedupe:testimonials": "node --experimental-strip-types --experimental-specifier-resolution=node contentful/scripts/dedupe-testimonials.ts",
    "contentful:prune:retired": "node --experimental-strip-types --experimental-specifier-resolution=node contentful/scripts/prune-retired-types.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:destroy:local": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "db:reset:local": "prisma migrate reset --force && pnpm run prisma:seed:local",
    "db:status:staging": "node scripts/prisma-deploy.mjs staging status",
    "db:migrate:staging": "node scripts/prisma-deploy.mjs staging deploy",
    "db:status:prod": "node scripts/prisma-deploy.mjs prod status",
    "db:migrate:prod": "node scripts/prisma-deploy.mjs prod deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed:local": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed.ts",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed:admin": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed-auth.ts",
    "prisma:seed:test-admin": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed-test-admin.ts",
    "prisma:seed:preview": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed-preview.ts",
    "prisma:seed:billing": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed-billing.ts",
    "data:import:legacy": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/data/import-legacy.ts",
    "classes:publish-sessions": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/classes/publish-upcoming-sessions.ts",
    "classes:process-three-hour-cutoff": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/classes/process-three-hour-cutoff.ts",
    "stripe:seed:products": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/stripe/seed-products.ts",
    "sync:postmark": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/sync/postmark.ts",
    "sync:stripe:metrics": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/sync/stripe-metrics.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,scss,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@popperjs/core": "2.11.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.38.0",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "0.4.6",
    "pg": "^8.21.0",
    "postmark": "^4.0.7",
    "react": "^19.2.8",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.2.8",
    "react-email": "^5.2.10",
    "react-hook-form": "7.72.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "stripe": "^22.2.1",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "contentful-management": "^12.5.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "prisma": "^7.8.0",
    "tailwindcss": "4.2.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
