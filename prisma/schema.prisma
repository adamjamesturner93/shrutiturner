  contentfulEntryId           String?                   @unique
  templateContentfulEntryId   String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  sessions              SmallGroupProgrammeSession[]
  enrollments           SmallGroupProgrammeEnrollment[]
  giftPurchases         GiftPurchase[]
  replayAssets          ReplayAsset[]
  refundRule            RefundRule?                               @relation(fields: [refundRuleId], references: [id], onDelete: SetNull)
  instructorAssignments SmallGroupProgrammeInstructorAssignment[]

  @@index([status, startDate])
  @@index([templateSlug, status, startDate])
  @@index([refundRuleId])
}

model SmallGroupProgrammeSession {
  id               String                  @id @default(cuid())
  programmeId      String
  instructorUserId String?
  title            String
  startsAt         DateTime
  endsAt           DateTime?
  sequenceNumber   Int
  status           SmallGroupSessionStatus @default(scheduled)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  programme    SmallGroupProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  instructor   User?               @relation("SmallGroupProgrammeSessionInstructor", fields: [instructorUserId], references: [id], onDelete: SetNull)
  replayAssets ReplayAsset[]

  @@unique([programmeId, sequenceNumber])
  @@index([programmeId, startsAt])
  @@index([instructorUserId, startsAt])
}

model SmallGroupProgrammeEnrollment {
  id                      String                     @id @default(cuid())
  programmeId             String
  userId                  String?
  attendeeName            String
  attendeeEmail           String
  sessionsAttended        Int                        @default(0)
  progressSummary         String?
  status                  SmallGroupEnrollmentStatus @default(active)
  pricePaidPence          Int?
  currency                String                     @default("GBP")
  stripeCheckoutSessionId String?                    @unique
  stripePaymentIntentId   String?
  paymentWindowExpiresAt  DateTime?
  complianceSnapshotJson  Json?
  giftPurchaseId          String?                    @unique
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  programme    SmallGroupProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  giftPurchase GiftPurchase?       @relation("GiftPurchaseProgrammeEnrollment", fields: [giftPurchaseId], references: [id], onDelete: SetNull)

  @@index([programmeId, status])
  @@index([userId, status])
  @@index([attendeeEmail, status])
  @@index([paymentWindowExpiresAt, status])
}

model SmallGroupProgrammeInstructorAssignment {
  id          String   @id @default(cuid())
  programmeId String
  userId      String
  createdAt   DateTime @default(now())

  programme SmallGroupProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programmeId, userId])
  @@index([userId, createdAt])
}

model ThemedWeek {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String   @db.Text
  audience         String   @db.Text
  ctaHref          String
  ctaLabel         String
  startDate        DateTime
  endDate          DateTime
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([sortOrder, startDate])
}

model BlogComment {
  id           String            @id @default(cuid())
  postSlug     String
  authorUserId String
  parentId     String?
  content      String            @db.Text
  status       BlogCommentStatus @default(visible)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  author  User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("BlogCommentReplies")

  @@index([postSlug, status, createdAt])
  @@index([authorUserId, createdAt])
  @@index([parentId])
}

model BlogReaction {
  id             String   @id @default(cuid())
  postSlug       String
  userId         String?
  anonymousToken String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postSlug, userId])
  @@unique([postSlug, anonymousToken])
  @@index([postSlug, createdAt])
}

model ContactSubmission {
  id         String                  @id @default(cuid())
  userId     String?
  firstName  String
  lastName   String
  email      String
  topic      String
  conditions String?
  howFound   String?
  message    String                  @db.Text
  status     ContactSubmissionStatus @default(new)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}
