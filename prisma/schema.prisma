model User {
  id                               String    @id @default(cuid())
  firstName                        String?
  lastName                         String?
  name                             String?
  email                            String    @unique
  pendingEmail                     String?
  emailVerified                    DateTime?
  image                            String?
  role                             UserRole  @default(student)
  dob                              DateTime?
  gender                           String?
  ethnicity                        String?
  timezone                         String    @default("Europe/London")
  dateFormat                       String    @default("DD/MM/YYYY")
  isOnboarded                      Boolean   @default(false)
  hasAgreedToTerms                 Boolean   @default(false)
  hasAgreedToHealth                Boolean   @default(false)
  termsAgreedAt                    DateTime?
  healthAgreedAt                   DateTime?
  acceptedTermsVersion             String?
  acceptedHealthWaiverVersion      String?
  hasConsentedToHealthData         Boolean   @default(false)
  acceptedHealthDataConsentVersion String?
  healthDataConsentedAt            DateTime?
  heardAboutSource                 String?
  heardAboutDetail                 String?
  stripeCustomerId                 String?   @unique
  isCoachingClient                 Boolean   @default(false)
  adminNotes                       String?
  referralCode                     String?   @unique
  instructorProfileEntryId         String?
  referredByUserId                 String?
  authCode                         String?
  authCodeExpiry                   DateTime?
  deletedAt                        DateTime?
  legalHoldUntil                   DateTime?
  legalHoldReason                  String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  referredBy User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals  User[]    @relation("UserReferrals")

  referralEventsCreated                 ReferralEvent[]                           @relation("ReferrerEvents")
  referralEventsReceived                ReferralEvent[]                           @relation("ReferredEvents")
  referralLedgerEntries                 ReferralLedgerEntry[]
  membershipSubscriptions               MembershipSubscription[]
  membershipDunningCases                MembershipDunningCase[]
  billingRefunds                        BillingRefund[]                           @relation("BillingRefundUser")
  billingRefundActions                  BillingRefund[]                           @relation("BillingRefundActor")
  subscriptionComplianceEvents          SubscriptionComplianceEvent[]
  creditLedgerEntries                   CreditLedgerEntry[]
  billingEvents                         BillingEvent[]                            @relation("UserBillingEvents")
  healthProfileRevisions                HealthProfileRevision[]
  notificationPreference                UserNotificationPreference?
  healthProfile                         HealthProfile?
  createdCreditAdjustments              CreditLedgerEntry[]                       @relation("CreditAdjustmentsBy")
  instructedClassSessions               ClassSession[]                            @relation("SessionInstructor")
  cancelledClassSessions                ClassSession[]                            @relation("SessionCancelledBy")
  classTimetableRules                   ClassTimetableRule[]                      @relation("ClassTimetableInstructor")
  createdClassTimetableRules            ClassTimetableRule[]                      @relation("ClassTimetableCreatedBy")
  classBookings                         ClassBooking[]
  classWaitlistEntries                  ClassWaitlistEntry[]
  emailDeliveries                       EmailDelivery[]
  resolvedEmailDeliveries               EmailDelivery[]                           @relation("EmailDeliveryResolvedBy")
  emailEvents                           EmailEvent[]
  attendanceOverrides                   ClassBooking[]                            @relation("AttendanceMarkedBy")
  classAttendanceEvents                 ClassAttendanceEvent[]
  newsletterSubscriber                  NewsletterSubscriber?
  giftPurchasesMade                     GiftPurchase[]                            @relation("GiftPurchasePurchaser")
  giftPurchasesRedeemed                 GiftPurchase[]                            @relation("GiftPurchaseRedeemer")
  retreatBookingsPurchased              RetreatBooking[]                          @relation("RetreatBookingPurchaser")
  retreatBookingsAttending              RetreatBooking[]                          @relation("RetreatBookingAttendee")
  retreatAttendees                      RetreatAttendee[]
  retreatOnlineAccessEntitlements       RetreatOnlineAccessEntitlement[]
  coachingApplications                  CoachingApplication[]
  coachingProfile                       CoachingClientProfile?
  coachingPackageChangeRequests         CoachingPackageChangeRequest[]            @relation("CoachingPackageChangeClient")
  requestedCoachingPackageChanges       CoachingPackageChangeRequest[]            @relation("CoachingPackageChangeRequester")
  blogComments                          BlogComment[]
  blogReactions                         BlogReaction[]
  smallGroupEnrollments                 SmallGroupProgrammeEnrollment[]
  contactSubmissions                    ContactSubmission[]
  acceptanceEvents                      AcceptanceEvent[]                         @relation("AcceptanceSubject")
  acceptanceActions                     AcceptanceEvent[]                         @relation("AcceptanceActor")
  createdIncidentLogs                   IncidentLog[]                             @relation("IncidentActor")
  affectedIncidentLogs                  IncidentLog[]                             @relation("IncidentAffectedUser")
  publishedPolicyVersions               PolicyDocumentVersion[]                   @relation("PolicyVersionPublishedBy")
  publishedRefundRules                  RefundRule[]                              @relation("RefundRulePublishedBy")
  replayEntitlements                    ReplayEntitlement[]                       @relation("ReplayEntitlementUser")
  replayEntitlementRevocations          ReplayEntitlement[]                       @relation("ReplayEntitlementRevokedBy")
  retreatInstructorAssignments          RetreatDateInstructorAssignment[]
  retreatLiveAttendance                 RetreatLiveAttendance[]
  retreatLiveChatMessages               RetreatLiveChatMessage[]
  smallGroupInstructorAssignments       SmallGroupProgrammeInstructorAssignment[]
  scheduledJobRuns                      ScheduledJobRun[]                         @relation("ScheduledJobActor")
  scheduledJobLeases                    ScheduledJobLease[]                       @relation("ScheduledJobLeaseActor")
  privacyRequestsForSubject             PrivacyRequest[]                          @relation("PrivacyRequestSubject")
  privacyRequestsActed                  PrivacyRequest[]                          @relation("PrivacyRequestActor")
  adminActionLogs                       AdminActionLog[]                          @relation("AdminActionActor")
  authChallenges                        AuthChallenge[]
  lifecycleEvents                       UserLifecycleEvent[]                      @relation("UserLifecycleSubject")
  lifecycleActions                      UserLifecycleEvent[]                      @relation("UserLifecycleActor")
  platformSettingsUpdates               PlatformSetting[]                         @relation("PlatformSettingUpdatedBy")
  billingDisputeCases                   BillingDisputeCase[]                      @relation("BillingDisputeUser")
  moderationActionsTaken                ParticipantModerationAction[]             @relation("ModerationActor")
  moderationActionsReceived             ParticipantModerationAction[]             @relation("ModerationSubject")
  participantBlocks                     SessionParticipantBlock[]                 @relation("SessionParticipantBlockedUser")
  participantBlocksCreated              SessionParticipantBlock[]                 @relation("SessionParticipantBlockActor")
  instructedSmallGroupProgrammeSessions SmallGroupProgrammeSession[]              @relation("SmallGroupProgrammeSessionInstructor")
}

model PolicyDocumentVersion {
  id                String         @id @default(cuid())
  type              AcceptanceType
  slug              String
  version           String
  label             String
  contentSource     String         @default("app")
  publishedAt       DateTime
  publishedByUserId String?
  isCurrent         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  publishedBy           User?                  @relation("PolicyVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  acceptanceEvents      AcceptanceEvent[]
  guestAcceptanceEvents GuestAcceptanceEvent[]

  @@unique([type, version])
  @@index([type, isCurrent])
  @@index([slug, isCurrent])
}

model AcceptanceEvent {
  id                String         @id @default(cuid())
  userId            String
  actorUserId       String?
  type              AcceptanceType
  policyVersionId   String?
  version           String
  acceptanceSurface String
  acceptedAt        DateTime       @default(now())
  metadataJson      Json?
  createdAt         DateTime       @default(now())

  user          User                   @relation("AcceptanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor         User?                  @relation("AcceptanceActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  policyVersion PolicyDocumentVersion? @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)

  @@index([userId, type, acceptedAt])
  @@index([policyVersionId, acceptedAt])
  @@index([actorUserId, acceptedAt])
}

model IncidentLog {
  id             String           @id @default(cuid())
  category       IncidentCategory
  severity       String           @default("medium")
  sessionId      String?
  affectedUserId String?
  actorUserId    String
  notes          String
  followUpNotes  String?
  metadataJson   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  session      ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  affectedUser User?         @relation("IncidentAffectedUser", fields: [affectedUserId], references: [id], onDelete: SetNull)
  actor        User          @relation("IncidentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([affectedUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([category, createdAt])
}

model ReplayAsset {
  id                           String            @id @default(cuid())
  resourceType                 String
  classSessionId               String?           @unique
  retreatDateId                String?
  smallGroupProgrammeId        String?
  smallGroupProgrammeSessionId String?
  dailyRoomName                String?
  dailyRecordingId             String?           @unique
  playbackUrl                  String?
  status                       ReplayAssetStatus @default(processing)
  startedAt                    DateTime?
  completedAt                  DateTime?
  deleteAfterAt                DateTime?
  deletedAt                    DateTime?
  syncError                    String?
  recordingConfigSnapshotJson  Json?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  classSession               ClassSession?               @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  retreatDate                RetreatDate?                @relation(fields: [retreatDateId], references: [id], onDelete: Cascade)
  smallGroupProgramme        SmallGroupProgramme?        @relation(fields: [smallGroupProgrammeId], references: [id], onDelete: Cascade)
  smallGroupProgrammeSession SmallGroupProgrammeSession? @relation(fields: [smallGroupProgrammeSessionId], references: [id], onDelete: Cascade)
  entitlements               ReplayEntitlement[]

  @@index([resourceType, status])
  @@index([deleteAfterAt, status])
  @@index([dailyRoomName])
  @@index([retreatDateId])
  @@index([smallGroupProgrammeId])
  @@index([smallGroupProgrammeSessionId])
}

model ReplayEntitlement {
  id                     String                      @id @default(cuid())
  replayAssetId          String
  userId                 String
  accessType             ReplayEntitlementAccessType
  startsAt               DateTime                    @default(now())
  endsAt                 DateTime
  revokedAt              DateTime?
  revokedByUserId        String?
  complianceSnapshotJson Json?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  replayAsset ReplayAsset @relation(fields: [replayAssetId], references: [id], onDelete: Cascade)
  user        User        @relation("ReplayEntitlementUser", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy   User?       @relation("ReplayEntitlementRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([replayAssetId, userId, accessType])
  @@index([userId, endsAt, revokedAt])
  @@index([replayAssetId, accessType])
}

model RefundRule {
  id                String    @id @default(cuid())
  family            String
  code              String
  version           String
  description       String?
  configJson        Json
  activeFrom        DateTime  @default(now())
  activeUntil       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  publishedBy          User?                 @relation("RefundRulePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  retreatDates         RetreatDate[]
  smallGroupProgrammes SmallGroupProgramme[]

  @@unique([family, code, version])
  @@index([family, activeFrom, activeUntil])
}

model PrivacyRequest {
  id                  String               @id @default(cuid())
  userId              String
  actorUserId         String
  type                PrivacyRequestType
  status              PrivacyRequestStatus @default(pending)
  summaryChecksum     String?
  summaryJson         Json?
  exportSectionsJson  Json?
  exportRowCountsJson Json?
  blockReason         String?
  generatedAt         DateTime?
  executedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user  User @relation("PrivacyRequestSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("PrivacyRequestActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([userId, type, createdAt])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
}

model AdminActionLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actionType   String
  targetType   String
  targetId     String?
  reason       String?
  requestId    String?
  requestPath  String?
  requestIp    String?
  oldValueJson Json?
  newValueJson Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor User @relation("AdminActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actionType, createdAt])
}

model AuthChallenge {
  id            String               @id @default(cuid())
  email         String
  userId        String?
  purpose       AuthChallengePurpose
  codeHash      String
  expiresAt     DateTime
  attemptCount  Int                  @default(0)
  maxAttempts   Int                  @default(3)
  sentAt        DateTime             @default(now())
  sentIp        String?
  lastAttemptAt DateTime?
  lastAttemptIp String?
  redirectTo    String?
  consumedAt    DateTime?
  metadataJson  Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, expiresAt])
  @@index([userId, purpose, expiresAt])
  @@index([consumedAt, expiresAt])
}

model UserLifecycleEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  actorUserId String?
  payloadJson Json?
  createdAt   DateTime @default(now())

  user  User? @relation("UserLifecycleSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("UserLifecycleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

model PlatformSetting {
  id                    String   @id @default("default")
  businessName          String   @default("Shruti Turner")
  supportEmail          String?
  contactEmail          String?
  instagramUrl          String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  gaMeasurementId       String?
  updatedByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model ScheduledJobRun {
  id           String                  @id @default(cuid())
  jobName      String
  triggerType  ScheduledJobTriggerType
  actorUserId  String?
  status       ScheduledJobRunStatus   @default(started)
  countersJson Json?
  errorSummary String?
  startedAt    DateTime                @default(now())
  finishedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  actor User? @relation("ScheduledJobActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([jobName, createdAt])
  @@index([status, createdAt])
}

model ScheduledJobLease {
  jobName     String   @id
  leaseId     String   @unique
  actorUserId String?
  leasedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actor User? @relation("ScheduledJobLeaseActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leasedUntil])
}

model BillingDisputeCase {
  id              String               @id @default(cuid())
  stripeDisputeId String               @unique
  userId          String?
  paymentIntentId String?
  chargeId        String?
  purchaserEmail  String?
  resourceType    String?
  resourceId      String?
  status          BillingDisputeStatus @default(open)
  openedAt        DateTime
  closedAt        DateTime?
  payloadJson     Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User? @relation("BillingDisputeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status, openedAt])
  @@index([purchaserEmail, status, openedAt])
  @@index([resourceType, resourceId, status])
  @@index([paymentIntentId])
  @@index([chargeId])
}

model ParticipantModerationAction {
  id           String                          @id @default(cuid())
  sessionId    String
  userId       String
  actorUserId  String
  actionType   ParticipantModerationActionType
  reason       String
  metadataJson Json?
  createdAt    DateTime                        @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation("ModerationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor   User         @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

model SessionParticipantBlock {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String
  actorUserId  String
  reason       String
  active       Boolean   @default(true)
  blockedUntil DateTime?
  liftedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation("SessionParticipantBlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor   User         @relation("SessionParticipantBlockActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([sessionId, userId, active])
  @@index([sessionId, active])
  @@index([userId, active])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

