generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  admin
}

enum ReferralEventStatus {
  pending_signup
  pending_qualification
  qualified
  rewarded
  void
}

enum ReferralLedgerType {
  reward
  adjustment
  applied
}

enum MembershipPlan {
  movewell
  instructor
}

enum MembershipBillingInterval {
  monthly
  annual
}

enum MembershipStatus {
  active
  paused
  cancelled
  expired
  past_due
}

enum SubscriptionComplianceEventKind {
  disclosure_acknowledged
  trial_reminder
  monthly_reminder
  annual_renewal_reminder
  renewal_cooling_off_notice
  end_of_contract_notice
  membership_cancelled
  cooling_off_cancellation
  refund_issued
}

enum CreditEntryType {
  purchase
  booking_use
  booking_refund
  admin_adjustment
  referral_applied
  promo
}

enum ClassSessionStatus {
  draft
  scheduled
  live
  completed
  cancelled
}

enum ClassRoomSetupStatus {
  pending
  ready
  failed
}

enum ClassBookingStatus {
  booked
  cancelled
  attended
  no_show
}

enum BookingEntitlementType {
  membership
  credit
  manual
}

enum ClassWaitlistStatus {
  waiting
  promoted
  removed
}

enum AttendanceSource {
  daily
  manual
}

enum ClassAttendanceEventType {
  joined
  left
}

enum PostClassFeeling {
  great
  good
  okay
  tough
  too_much
}

enum HealthDeclarationStatus {
  none_declared
  context_declared
}

enum ClassSessionEventType {
  booking_created
  booking_cancelled
  waitlist_joined
  waitlist_promoted
  session_cancelled
}

enum BillingEventStatus {
  received
  processed
  ignored
  failed
}

enum NewsletterSubscriberStatus {
  subscribed
  unsubscribed
}

enum RetreatDateStatus {
  open
  sold_out
  cancelled
  completed
}

enum RetreatBookingStatus {
  pending
  deposit_paid
  balance_due
  paid_in_full
  cancelled
  refunded
}

enum RetreatPaymentStatus {
  unpaid
  deposit_paid
  partially_paid
  paid_in_full
  refunded
  failed
}

enum GiftType {
  retreat
  small_group
}

enum GiftPurchaseStatus {
  pending_payment
  purchased
  redeemed
  expired
  cancelled
}

enum GiftDeliveryTarget {
  recipient
  buyer
}

enum CoachingSupportTier {
  personal_programme
  coached_plan
  coaching
  unsure
}

enum CoachingApplicationStatus {
  submitted
  under_review
  follow_up_needed
  approved
  declined
  converted
}

enum CoachingClientStatus {
  application_pending
  onboarding
  active
  paused
  completed
}

enum EverfitConnectionStatus {
  not_started
  invite_sent
  connected
  sync_issue
}

enum CoachingSessionStatus {
  scheduled
  completed
  cancelled
}

enum CoachingCheckInCadence {
  weekly
  monthly
}

enum CoachingCheckInStatus {
  due
  submitted
  reviewed
  overdue
}

enum BlogCommentStatus {
  visible
  hidden
  deleted
}

enum ContactSubmissionStatus {
  new
  archived
}

enum SmallGroupProgrammeStatus {
  draft
  upcoming
  open
  in_progress
  completed
  waitlist
  archived
}

enum SmallGroupSessionStatus {
  scheduled
  completed
  cancelled
}

enum SmallGroupEnrollmentStatus {
  pending_payment
  active
  completed
  cancelled
  waitlist
}

model User {
  id               String    @id @default(cuid())
  firstName        String?
  lastName         String?
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole  @default(student)
  dob              DateTime?
  gender           String?
  ethnicity        String?
  timezone         String    @default("Europe/London")
  dateFormat       String    @default("DD/MM/YYYY")
  isOnboarded      Boolean   @default(false)
  hasAgreedToTerms Boolean   @default(false)
  hasAgreedToHealth Boolean  @default(false)
  termsAgreedAt    DateTime?
  healthAgreedAt   DateTime?
  acceptedTermsVersion String?
  acceptedHealthWaiverVersion String?
  hasConsentedToHealthData Boolean @default(false)
  acceptedHealthDataConsentVersion String?
  healthDataConsentedAt DateTime?
  heardAboutSource String?
  heardAboutDetail String?
  stripeCustomerId String?   @unique
  isCoachingClient Boolean   @default(false)
  adminNotes       String?
  referralCode     String?   @unique
  instructorProfileEntryId String?
  referredByUserId String?
  authCode         String?
  authCodeExpiry   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  referredBy User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals  User[]    @relation("UserReferrals")

  referralEventsCreated  ReferralEvent[]             @relation("ReferrerEvents")
  referralEventsReceived ReferralEvent[]             @relation("ReferredEvents")
  referralLedgerEntries  ReferralLedgerEntry[]
  membershipSubscriptions MembershipSubscription[]
  subscriptionComplianceEvents SubscriptionComplianceEvent[]
  creditLedgerEntries    CreditLedgerEntry[]
  billingEvents          BillingEvent[]             @relation("UserBillingEvents")
  healthProfileRevisions HealthProfileRevision[]
  notificationPreference UserNotificationPreference?
  healthProfile          HealthProfile?
  createdCreditAdjustments CreditLedgerEntry[]      @relation("CreditAdjustmentsBy")
  instructedClassSessions ClassSession[]            @relation("SessionInstructor")
  cancelledClassSessions ClassSession[]             @relation("SessionCancelledBy")
  classTimetableRules    ClassTimetableRule[]       @relation("ClassTimetableInstructor")
  createdClassTimetableRules ClassTimetableRule[]   @relation("ClassTimetableCreatedBy")
  classBookings          ClassBooking[]
  classWaitlistEntries   ClassWaitlistEntry[]
  emailEvents            EmailEvent[]
  attendanceOverrides    ClassBooking[]             @relation("AttendanceMarkedBy")
  classAttendanceEvents  ClassAttendanceEvent[]
  newsletterSubscriber   NewsletterSubscriber?
  giftPurchasesMade      GiftPurchase[]          @relation("GiftPurchasePurchaser")
  giftPurchasesRedeemed  GiftPurchase[]          @relation("GiftPurchaseRedeemer")
  retreatBookingsPurchased RetreatBooking[]         @relation("RetreatBookingPurchaser")
  retreatBookingsAttending RetreatBooking[]         @relation("RetreatBookingAttendee")
  coachingApplications   CoachingApplication[]
  coachingProfile        CoachingClientProfile?
  blogComments           BlogComment[]
  blogReactions          BlogReaction[]
  smallGroupEnrollments  SmallGroupProgrammeEnrollment[]
  contactSubmissions     ContactSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReferralEvent {
  id                   String              @id @default(cuid())
  referrerUserId       String
  referredUserId       String
  referralCodeSnapshot String
  status               ReferralEventStatus @default(pending_signup)
  qualifiedAt          DateTime?
  rewardedAt           DateTime?
  giftGrantedAt        DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  referrerUser  User                  @relation("ReferrerEvents", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUser  User                  @relation("ReferredEvents", fields: [referredUserId], references: [id], onDelete: Cascade)
  ledgerEntries ReferralLedgerEntry[]

  @@unique([referrerUserId, referredUserId])
  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([status])
}

model ReferralLedgerEntry {
  id          String             @id @default(cuid())
  userId      String
  eventId     String?
  amountPence Int
  currency    String             @default("GBP")
  type        ReferralLedgerType
  description String
  appliedToBillingEventId String?
  stripeInvoiceId String?
  stripeCheckoutSessionId String?
  createdAt   DateTime           @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event ReferralEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  appliedToBillingEvent BillingEvent? @relation(fields: [appliedToBillingEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([appliedToBillingEventId])
}

model MembershipSubscription {
  id                     String           @id @default(cuid())
  userId                 String
  plan                   MembershipPlan
  billingInterval        MembershipBillingInterval @default(monthly)
  status                 MembershipStatus
  pricePence             Int
  currency               String           @default("GBP")
  classesPerWeek         Int
  classesUsedThisWeek    Int              @default(0)
  startsAt               DateTime         @default(now())
  renewsAt               DateTime?
  endsAt                 DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  disclosureVersion      String?
  disclosureAcceptedAt   DateTime?
  trialEndsAt            DateTime?
  initialCoolingOffEndsAt DateTime?
  renewalCoolingOffStartedAt DateTime?
  renewalCoolingOffEndsAt DateTime?
  renewalCoolingOffKind  String?
  latestInvoiceId        String?
  latestInvoiceAmountPence Int?
  latestInvoicePaidAt    DateTime?
  stripeSubscriptionId   String?          @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  complianceEvents SubscriptionComplianceEvent[]

  @@index([userId, status])
  @@index([stripeSubscriptionId])
}

model SubscriptionComplianceEvent {
  id             String                          @id @default(cuid())
  userId         String
  membershipId   String?
  kind           SubscriptionComplianceEventKind
  status         String
  channel        String                          @default("app")
  summary        String
  metadataJson   Json?
  eventAt        DateTime                        @default(now())
  createdAt      DateTime                        @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership MembershipSubscription? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId, eventAt])
  @@index([membershipId, eventAt])
  @@index([kind, eventAt])
}

model CreditLedgerEntry {
  id                      String        @id @default(cuid())
  userId                  String
  amount                  Int
  type                    CreditEntryType
  description             String
  sourceRef               String?
  expiresAt               DateTime?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeInvoiceId         String?
  createdByUserId         String?
  createdAt               DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("CreditAdjustmentsBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  classBookings ClassBooking[] @relation("BookingCreditLedger")

  @@index([userId, createdAt])
  @@index([createdByUserId])
  @@index([stripeCheckoutSessionId])
}

model BillingEvent {
  id              String             @id @default(cuid())
  provider        String             @default("stripe")
  providerEventId String             @unique
  type            String
  status          BillingEventStatus @default(received)
  payloadJson     Json
  errorMessage    String?
  processedAt     DateTime?
  userId          String?
  createdAt       DateTime           @default(now())

  user User? @relation("UserBillingEvents", fields: [userId], references: [id], onDelete: SetNull)
  referralLedgerEntries ReferralLedgerEntry[]

  @@index([provider, type])
  @@index([status, createdAt])
}

model BillingMetricDaily {
  id                    String   @id @default(cuid())
  date                  DateTime @unique
  cashCollectedPence    Int      @default(0)
  failedPaymentsCount   Int      @default(0)
  activeMembersCount    Int      @default(0)
  mrrPence              Int      @default(0)
  churnedMembersCount   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model HealthProfile {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  declarationStatus   HealthDeclarationStatus @default(none_declared)
  tracksFlareCheckIns Boolean                 @default(false)
  additionalNotes     String                  @default("")
  lastConfirmedAt     DateTime                @default(now())
  lastUpdatedAt       DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  selections HealthConditionSelection[]
  revisions  HealthProfileRevision[]
}

model HealthConditionSelection {
  id           String   @id @default(cuid())
  profileId    String
  conditionKey String
  detail       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, conditionKey])
  @@index([profileId])
}

model HealthProfileRevision {
  id              String   @id @default(cuid())
  profileId       String
  updatedByUserId String
  snapshotJson    Json
  createdAt       DateTime @default(now())

  profile       HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  updatedByUser User          @relation(fields: [updatedByUserId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([updatedByUserId])
}

model UserNotificationPreference {
  userId               String   @id
  classReminders       Boolean  @default(true)
  scheduleUpdates      Boolean  @default(true)
  programAnnouncements Boolean  @default(true)
  marketingEmails      Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClassTimetableRule {
  id                      String   @id @default(cuid())
  classDefinitionSlug     String
  weekday                 Int
  startsAtLocal           String
  durationMinutes         Int
  timezone                String   @default("Europe/London")
  defaultCapacity         Int
  instructorUserId        String
  instructorProfileEntryId String?
  startsOn                DateTime
  endsOn                  DateTime?
  active                  Boolean  @default(true)
  notes                   String?
  createdByUserId         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  instructor User @relation("ClassTimetableInstructor", fields: [instructorUserId], references: [id], onDelete: Restrict)
  createdBy  User @relation("ClassTimetableCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  exclusions ClassTimetableExclusion[]
  sessions   ClassSession[]

  @@index([active, weekday, startsOn])
  @@index([instructorUserId, active])
}

model ClassTimetableExclusion {
  id              String   @id @default(cuid())
  timetableRuleId String
  localDate       DateTime
  reason          String?
  createdAt       DateTime @default(now())

  timetableRule ClassTimetableRule @relation(fields: [timetableRuleId], references: [id], onDelete: Cascade)

  @@unique([timetableRuleId, localDate])
  @@index([localDate])
}

model ClassSession {
  id                 String             @id @default(cuid())
  classDefinitionSlug String
  timetableRuleId    String?
  localDate          DateTime?
  generationKey      String?            @unique
  titleSnapshot      String
  typeSnapshot       String
  durationMinutes    Int
  levelSnapshot      String
  startsAtUtc        DateTime
  endsAtUtc          DateTime
  timezone           String             @default("Europe/London")
  capacity           Int
  status             ClassSessionStatus @default(scheduled)
  notes              String?
  instructorUserId   String
  instructorProfileEntryId String?
  instructorNameSnapshot String?
  instructorBioSnapshot String?
  roomSetupStatus    ClassRoomSetupStatus @default(pending)
  roomSetupError     String?
  dailyRoomName      String?
  dailyRoomUrl       String?
  communityModeEnabled Boolean         @default(false)
  communityModeUpdatedAt DateTime?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelReason       String?
  reminderProcessedAt DateTime?
  autoCancelledForNoAttendanceAt DateTime?
  firstSignupInstructorEmailSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  timetableRule ClassTimetableRule? @relation(fields: [timetableRuleId], references: [id], onDelete: SetNull)
  instructor   User                 @relation("SessionInstructor", fields: [instructorUserId], references: [id], onDelete: Restrict)
  cancelledBy  User?                @relation("SessionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  bookings     ClassBooking[]
  waitlist     ClassWaitlistEntry[]
  events       ClassSessionEvent[]
  attendanceEvents ClassAttendanceEvent[]

  @@index([classDefinitionSlug, startsAtUtc])
  @@index([startsAtUtc, status])
  @@index([instructorUserId, startsAtUtc])
  @@index([timetableRuleId, startsAtUtc])
  @@index([roomSetupStatus, startsAtUtc])
}

model ClassBooking {
  id          String             @id @default(cuid())
  sessionId   String
  userId      String
  status      ClassBookingStatus @default(booked)
  entitlementType BookingEntitlementType @default(manual)
  creditLedgerEntryId String? @unique
  bookedAt    DateTime           @default(now())
  firstJoinedAt DateTime?
  lastJoinedAt DateTime?
  lastLeftAt DateTime?
  joinCount    Int               @default(0)
  attendanceMarkedAt DateTime?
  attendanceMarkedByUserId String?
  attendanceSource AttendanceSource?
  preClassEnergyLevel Int?
  preClassFlareToday Boolean?
  preClassSubmittedAt DateTime?
  postClassFeeling PostClassFeeling?
  postClassSubmittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditLedgerEntry CreditLedgerEntry? @relation("BookingCreditLedger", fields: [creditLedgerEntryId], references: [id], onDelete: SetNull)
  attendanceMarkedByUser User? @relation("AttendanceMarkedBy", fields: [attendanceMarkedByUserId], references: [id], onDelete: SetNull)
  attendanceEvents ClassAttendanceEvent[]

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@index([sessionId, status])
  @@index([entitlementType])
  @@index([attendanceMarkedByUserId])
}

model ClassAttendanceEvent {
  id                 String                   @id @default(cuid())
  sessionId          String
  bookingId          String?
  userId             String
  dailyParticipantId String?
  type               ClassAttendanceEventType
  occurredAt         DateTime
  payload            Json?
  createdAt          DateTime                 @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking ClassBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([userId, occurredAt])
}

model ClassWaitlistEntry {
  id         String              @id @default(cuid())
  sessionId  String
  userId     String
  position   Int
  status     ClassWaitlistStatus @default(waiting)
  createdAt  DateTime            @default(now())
  promotedAt DateTime?
  updatedAt  DateTime            @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@unique([sessionId, position])
  @@index([sessionId, status, position])
  @@index([userId, status])
}

model ClassSessionEvent {
  id        String                @id @default(cuid())
  sessionId String
  type      ClassSessionEventType
  message   String?
  payload   Json?
  createdAt DateTime              @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
}

model EmailCampaign {
  id                String   @id @default(cuid())
  providerCampaignId String  @unique
  subject           String
  stream            String?
  status            String
  audienceType      String?
  triggeredBy       String?
  contentfulEntryId String?
  contentfulContentType String?
  postmarkBatchId   String?
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  errorSummary      String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  emailEvents EmailEvent[]

  @@index([status, sentAt])
  @@index([contentfulEntryId, contentfulContentType])
}

model EmailEvent {
  id              String   @id @default(cuid())
  provider        String   @default("postmark")
  providerEventId String   @unique
  messageId       String?
  type            String
  email           String
  userId          String?
  campaignId      String?
  eventAt         DateTime
  metadataJson    Json?
  createdAt       DateTime @default(now())

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([email, eventAt])
  @@index([type, eventAt])
  @@index([campaignId, eventAt])
  @@index([userId, eventAt])
}

model EmailAudienceSnapshot {
  id                    String   @id @default(cuid())
  date                  DateTime @unique
  newsletterCount       Int      @default(0)
  blogCount             Int      @default(0)
  bothCount             Int      @default(0)
  neitherCount          Int      @default(0)
  unsubscribes30d       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BillingCatalogItem {
  id              String   @id @default(cuid())
  key             String   @unique
  stripeProductId String
  stripePriceId   String   @unique
  currency        String   @default("GBP")
  unitAmountPence Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key, active])
}

model PromotionCodeMirror {
  id                    String   @id @default(cuid())
  stripeCouponId        String
  stripePromotionCodeId String   @unique
  code                  String   @unique
  type                  String
  amountOffPence        Int?
  percentOff            Float?
  currency              String?
  active                Boolean  @default(true)
  expiresAt             DateTime?
  maxRedemptions        Int?
  timesRedeemed         Int      @default(0)
  metadataJson          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([active, code])
}

model ClassOperationalSettings {
  id                            String   @id @default("default")
  preJoinWindowMinutes          Int      @default(10)
  lateJoinCutoffMinutes         Int      @default(5)
  creditRefundWindowMinutes     Int      @default(180)
  emptyClassAutoCancelWindowMinutes Int  @default(180)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String                     @id @default(cuid())
  email          String                     @unique
  userId         String?                    @unique
  status         NewsletterSubscriberStatus @default(subscribed)
  source         String?
  token          String                     @unique
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

model RetreatDate {
  id                          String            @id @default(cuid())
  externalDateId              String            @unique
  retreatSlug                 String
  retreatTitleSnapshot        String
  retreatLocationSnapshot     String
  startsAt                    DateTime
  endsAt                      DateTime
  capacity                    Int
  status                      RetreatDateStatus @default(open)
  currency                    String            @default("GBP")
  pricePence                  Int
  depositAmountPence          Int
  singleRoomSupplementPence   Int               @default(0)
  balanceDueAt                DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  bookings     RetreatBooking[]
  roomOptions  RetreatRoomOption[]
  giftPurchases GiftPurchase[]

  @@index([retreatSlug, startsAt])
  @@index([status, startsAt])
}

model RetreatRoomOption {
  id                 String      @id @default(cuid())
  retreatDateId      String
  externalRoomOptionId String
  label              String
  description        String?
  roomType           String
  guestsIncluded     Int         @default(1)
  capacity           Int
  availableSpots     Int
  pricePence         Int
  depositAmountPence Int?
  isWaitlistOnly     Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  retreatDate    RetreatDate      @relation(fields: [retreatDateId], references: [id], onDelete: Cascade)
  bookings       RetreatBooking[]
  giftPurchases  GiftPurchase[]

  @@unique([retreatDateId, externalRoomOptionId])
  @@index([retreatDateId, availableSpots])
}

model RetreatBooking {
  id                           String               @id @default(cuid())
  retreatDateId                String
  roomOptionId                 String?
  purchaserUserId              String?
  attendeeUserId               String?
  purchaserFirstName           String
  purchaserLastName            String
  purchaserEmail               String
  attendeeFirstName            String
  attendeeLastName             String
  attendeeEmail                String
  phone                        String
  emergencyContactName         String
  emergencyContactPhone        String
  dietaryRequirements          String?
  medicalConditions            String?
  mobilityNeeds                String?
  guestTwoFirstName            String?
  guestTwoLastName             String?
  guestTwoEmail                String?
  guestTwoDietaryRequirements  String?
  singleRoomRequested          Boolean              @default(false)
  roomType                     String?
  roomOptionLabelSnapshot      String?
  roomOptionTypeSnapshot       String?
  guestsIncluded               Int                  @default(1)
  giftPurchaseId               String?              @unique
  acceptedTermsVersion         String?
  acceptedHealthWaiverVersion  String?
  acceptedHealthDataVersion    String?
  totalPricePence              Int
  depositAmountPence           Int
  balanceAmountPence           Int
  depositPaidPence             Int                  @default(0)
  balancePaidPence             Int                  @default(0)
  currency                     String               @default("GBP")
  paymentStatus                RetreatPaymentStatus @default(unpaid)
  bookingStatus                RetreatBookingStatus @default(pending)
  stripeDepositSessionId       String?              @unique
  stripeBalanceSessionId       String?              @unique
  stripeDepositPaymentIntentId String?
  stripeBalancePaymentIntentId String?
  balancePaymentUrlToken       String?              @unique
  balanceDueAt                 DateTime?
  bookedAt                     DateTime             @default(now())
  depositPaidAt                DateTime?
  balancePaidAt                DateTime?
  cancelledAt                  DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  retreatDate    RetreatDate @relation(fields: [retreatDateId], references: [id], onDelete: Restrict)
  roomOption     RetreatRoomOption? @relation(fields: [roomOptionId], references: [id], onDelete: SetNull)
  purchaserUser  User?       @relation("RetreatBookingPurchaser", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  attendeeUser   User?       @relation("RetreatBookingAttendee", fields: [attendeeUserId], references: [id], onDelete: SetNull)
  giftPurchase   GiftPurchase? @relation("GiftPurchaseRetreatBooking", fields: [giftPurchaseId], references: [id], onDelete: SetNull)

  @@index([retreatDateId, bookingStatus])
  @@index([roomOptionId, bookingStatus])
  @@index([purchaserUserId, bookingStatus])
  @@index([attendeeUserId, bookingStatus])
  @@index([purchaserEmail, bookingStatus])
  @@index([attendeeEmail, bookingStatus])
  @@index([paymentStatus, balanceDueAt])
}

model GiftPurchase {
  id                    String             @id @default(cuid())
  code                  String             @unique
  type                  GiftType
  status                GiftPurchaseStatus @default(pending_payment)
  purchaserUserId       String?
  redeemedByUserId      String?
  purchaserFirstName    String
  purchaserLastName     String
  purchaserEmail        String
  recipientFirstName    String
  recipientLastName     String
  recipientEmail        String
  recipientMessage      String?            @db.Text
  deliveryTarget        GiftDeliveryTarget
  productSlug           String
  productTitleSnapshot  String
  currency              String             @default("GBP")
  totalPaidPence        Int
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId String?
  retreatDateId         String?
  retreatRoomOptionId   String?
  smallGroupProgrammeId String?
  expiresAt             DateTime?
  purchasedAt           DateTime?
  redeemedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  purchaserUser      User?                @relation("GiftPurchasePurchaser", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  redeemedByUser     User?                @relation("GiftPurchaseRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  retreatDate        RetreatDate?         @relation(fields: [retreatDateId], references: [id], onDelete: SetNull)
  retreatRoomOption  RetreatRoomOption?   @relation(fields: [retreatRoomOptionId], references: [id], onDelete: SetNull)
  smallGroupProgramme SmallGroupProgramme? @relation(fields: [smallGroupProgrammeId], references: [id], onDelete: SetNull)
  retreatBooking     RetreatBooking?      @relation("GiftPurchaseRetreatBooking")
  enrolment          SmallGroupProgrammeEnrollment? @relation("GiftPurchaseProgrammeEnrollment")

  @@index([status, type, createdAt])
  @@index([recipientEmail, status])
  @@index([purchaserEmail, status])
  @@index([retreatDateId, status])
  @@index([smallGroupProgrammeId, status])
}

model CoachingApplication {
  id                             String                   @id @default(cuid())
  userId                         String?
  applicantFirstName             String
  applicantLastName              String
  applicantEmail                 String
  tier                           CoachingSupportTier
  answersJson                    Json
  hasMoveWellMembershipSnapshot  Boolean                  @default(false)
  isExistingCoachingClientSnapshot Boolean                @default(false)
  source                         String?
  coachingAgreementVersion       String?
  coachingAgreementAcceptedAt    DateTime
  status                         CoachingApplicationStatus @default(submitted)
  adminNotes                     String?
  reviewedAt                     DateTime?
  approvedAt                     DateTime?
  convertedAt                    DateTime?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientProfile CoachingClientProfile?

  @@index([status, createdAt])
  @@index([tier, createdAt])
  @@index([userId, createdAt])
  @@index([applicantEmail, createdAt])
}

model CoachingClientProfile {
  id                        String                  @id @default(cuid())
  userId                    String                  @unique
  applicationId             String?                 @unique
  tier                      CoachingSupportTier
  status                    CoachingClientStatus    @default(onboarding)
  includesMoveWellMembership Boolean                @default(false)
  everfitConnectionStatus   EverfitConnectionStatus @default(not_started)
  onboardingChecklistJson   Json?
  nextCheckInDueAt          DateTime?
  latestCoachResponseSummary String?
  startDate                 DateTime?
  pausedAt                  DateTime?
  completedAt               DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CoachingApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sessions    CoachingSession[]
  checkIns    CoachingCheckIn[]

  @@index([status, updatedAt])
  @@index([tier, updatedAt])
}

model CoachingSession {
  id               String                @id @default(cuid())
  clientProfileId  String
  startsAt         DateTime
  endsAt           DateTime?
  sessionType      String                @default("coaching")
  status           CoachingSessionStatus @default(scheduled)
  summary          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  clientProfile CoachingClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId, startsAt])
  @@index([status, startsAt])
}

model CoachingCheckIn {
  id                    String                @id @default(cuid())
  clientProfileId       String
  cadence               CoachingCheckInCadence
  dueAt                 DateTime
  submittedAt           DateTime?
  reviewedAt            DateTime?
  status                CoachingCheckInStatus @default(due)
  answersJson           Json?
  coachResponseSummary  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  clientProfile CoachingClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId, dueAt])
  @@index([status, dueAt])
}

model SmallGroupProgramme {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  runSlug            String                   @unique
  templateSlug       String
  title              String
  subtitle           String?
  shortDescription   String                   @db.Text
  description        String?                  @db.Text
  longDescription    String?                  @db.Text
  durationLabel      String
  durationWeeks      Int?
  cohortSize         Int
  startDate          DateTime?
  endDate            DateTime?
  scheduleLabel      String?
  pricePence         Int
  sessionsPerWeek    Int?
  totalSessions      Int?
  status             SmallGroupProgrammeStatus @default(draft)
  ctaLabel           String?
  ctaHref            String?
  featuredBadge      String?
  whoItsForJson      Json?
  equipmentJson      Json?
  inclusionsJson     Json?
  weekByWeekJson     Json?
  contentfulEntryId  String?                  @unique
  templateContentfulEntryId String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  sessions    SmallGroupProgrammeSession[]
  enrollments SmallGroupProgrammeEnrollment[]
  giftPurchases GiftPurchase[]

  @@index([status, startDate])
  @@index([templateSlug, status, startDate])
}

model SmallGroupProgrammeSession {
  id                String                  @id @default(cuid())
  programmeId       String
  title             String
  startsAt          DateTime
  endsAt            DateTime?
  sequenceNumber    Int
  status            SmallGroupSessionStatus @default(scheduled)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  programme SmallGroupProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, sequenceNumber])
  @@index([programmeId, startsAt])
}

model SmallGroupProgrammeEnrollment {
  id              String                     @id @default(cuid())
  programmeId     String
  userId          String?
  attendeeName    String
  attendeeEmail   String
  sessionsAttended Int                       @default(0)
  progressSummary String?
  status          SmallGroupEnrollmentStatus @default(active)
  pricePaidPence  Int?
  currency        String                     @default("GBP")
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId String?
  paymentWindowExpiresAt DateTime?
  giftPurchaseId  String?                    @unique
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  programme SmallGroupProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  giftPurchase GiftPurchase?    @relation("GiftPurchaseProgrammeEnrollment", fields: [giftPurchaseId], references: [id], onDelete: SetNull)

  @@index([programmeId, status])
  @@index([userId, status])
  @@index([attendeeEmail, status])
  @@index([paymentWindowExpiresAt, status])
}

model ThemedWeek {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String   @db.Text
  audience         String   @db.Text
  ctaHref          String
  ctaLabel         String
  startDate        DateTime
  endDate          DateTime
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([sortOrder, startDate])
}

model BlogComment {
  id           String            @id @default(cuid())
  postSlug     String
  authorUserId String
  parentId     String?
  content      String            @db.Text
  status       BlogCommentStatus @default(visible)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  author  User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("BlogCommentReplies")

  @@index([postSlug, status, createdAt])
  @@index([authorUserId, createdAt])
  @@index([parentId])
}

model BlogReaction {
  id             String   @id @default(cuid())
  postSlug       String
  userId         String?
  anonymousToken String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postSlug, userId])
  @@unique([postSlug, anonymousToken])
  @@index([postSlug, createdAt])
}

model ContactSubmission {
  id         String                  @id @default(cuid())
  userId     String?
  firstName  String
  lastName   String
  email      String
  topic      String
  conditions String?
  howFound   String?
  message    String                  @db.Text
  status     ContactSubmissionStatus @default(new)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}
